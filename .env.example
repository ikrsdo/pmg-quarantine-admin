# Copy this file to .env and fill in the values.
# .env must never be committed to git.

# --- Demo mode ---
# Runs the app against an in-memory fake PMG instead of a real one - every
# screen works with realistic mock data, no PMG server needed. Login with
# demo/demo. Meant for a separate demo deployment/container, not your real
# instance - see README.md > "Demo mode". When true, PMG_BASE_URL below is
# not required.
DEMO_MODE=false

# --- PMG API connection ---
PMG_BASE_URL=https://pmg.example.local:8006
PMG_API_PATH=/api2/json
# Accept self-signed certificates? (only set true for lab/internal networks)
PMG_ALLOW_SELF_SIGNED=true

# NOTE: no PMG username/password is stored here. Each admin logs in with
# their own PMG account (Help Desk role, not root@pam) via the app's login
# screen; the backend forwards those credentials to PMG and only keeps the
# resulting ticket/CSRF token, tied to that admin's session. See CLAUDE.md
# > "Auth / Login Flow" for details.

# --- Backend/app settings ---
# NODE_ENV=production requires HTTPS for the session cookie to persist
# (see below). If DEMO_MODE=true above and you're trying it over plain
# http://<host>:3000 with no reverse proxy/tunnel, set this to
# "development" instead - safe to do only for a demo instance, since it
# never holds real PMG credentials.
NODE_ENV=production
PORT=3000
# Used to sign admin session cookies - must be a long, random value, never
# left at its default.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Reverse proxy / tunnel ---
# This app does not run its own reverse proxy or tunnel container - see
# README.md > "Exposing the app publicly" for wiring it up to whatever you
# already use (Cloudflare Tunnel, nginx, Traefik, etc.).
